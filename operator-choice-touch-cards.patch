+/* ===== terminal: выбор оператора для услуги — карточки для сенсорного экрана ===== */
+body.terminal-page .operator-choice-overlay{
+    position: fixed !important;
+    inset: 0 !important;
+    width: 100vw !important;
+    height: 100vh !important;
+    z-index: 20000 !important;
+    background: rgba(0, 0, 0, 0.72) !important;
+    display: none !important;
+    align-items: center !important;
+    justify-content: center !important;
+    padding: 24px !important;
+    box-sizing: border-box !important;
+}
+
+body.terminal-page .operator-choice-overlay.visible{
+    display: flex !important;
+}
+
+body.terminal-page .operator-choice-modal{
+    position: relative !important;
+    width: min(920px, 94vw) !important;
+    max-height: 88vh !important;
+    background: var(--card-bg) !important;
+    border-radius: 32px !important;
+    box-shadow: 0 35px 90px rgba(0,0,0,0.45) !important;
+    padding: 42px !important;
+    box-sizing: border-box !important;
+    text-align: center !important;
+    overflow: hidden !important;
+}
+
+body.terminal-page .operator-choice-list{
+    max-height: 46vh !important;
+    overflow-y: auto !important;
+    -webkit-overflow-scrolling: touch !important;
+    overscroll-behavior: contain !important;
+    display: grid !important;
+    grid-template-columns: 1fr !important;
+    gap: 16px !important;
+    padding: 6px 14px 6px 6px !important;
+    margin: 20px 0 18px 0 !important;
+    box-sizing: border-box !important;
+    scrollbar-width: auto !important;
+    scrollbar-color: var(--primary) #edf2f7 !important;
+}
+
+body.terminal-page .operator-choice-list::-webkit-scrollbar{
+    width: 18px !important;
+}
+
+body.terminal-page .operator-choice-list::-webkit-scrollbar-track{
+    background: #edf2f7 !important;
+    border-radius: 999px !important;
+}
+
+body.terminal-page .operator-choice-list::-webkit-scrollbar-thumb{
+    background: var(--primary) !important;
+    border-radius: 999px !important;
+    border: 4px solid #edf2f7 !important;
+}
+
+body.terminal-page .operator-choice-card{
+    width: 100% !important;
+    min-height: 92px !important;
+    border: 3px solid #e2e8f0 !important;
+    border-radius: 22px !important;
+    background: #f8fafc !important;
+    color: var(--primary) !important;
+    font-size: clamp(24px, 2.4vw, 32px) !important;
+    line-height: 1.18 !important;
+    font-weight: 900 !important;
+    display: flex !important;
+    align-items: center !important;
+    justify-content: center !important;
+    text-align: center !important;
+    padding: 18px 22px !important;
+    box-sizing: border-box !important;
+    cursor: pointer !important;
+    touch-action: manipulation !important;
+}
+
+body.terminal-page .operator-choice-card.selected{
+    background: var(--primary) !important;
+    color: #fff !important;
+    border-color: var(--accent) !important;
+    box-shadow: 0 0 0 6px rgba(0,170,255,0.18) !important;
+}
+
+body.terminal-page .operator-choice-loading,
+body.terminal-page .operator-choice-empty{
+    min-height: 92px !important;
+    border-radius: 22px !important;
+    background: #f8fafc !important;
+    color: var(--text-muted) !important;
+    font-size: 26px !important;
+    font-weight: 800 !important;
+    display: flex !important;
+    align-items: center !important;
+    justify-content: center !important;
+    text-align: center !important;
+    padding: 18px !important;
+    box-sizing: border-box !important;
+}
+
+body.terminal-page .operator-choice-error{
+    min-height: 30px !important;
+    margin: 8px 0 12px 0 !important;
+    color: var(--danger) !important;
+    font-size: 22px !important;
+    font-weight: 800 !important;
+}
+
+body.terminal-page .operator-choice-actions{
+    display: flex !important;
+    justify-content: center !important;
+    gap: 28px !important;
+    flex-wrap: wrap !important;
+    margin-top: 6px !important;
+}
+
+body.terminal-page .operator-choice-confirm,
+body.terminal-page .operator-choice-cancel{
+    min-width: 240px !important;
+    min-height: 78px !important;
+    border-radius: 20px !important;
+    border: none !important;
+    font-size: 24px !important;
+    font-weight: 900 !important;
+    text-transform: uppercase !important;
+    touch-action: manipulation !important;
+}
+
+body.terminal-page .operator-choice-confirm{
+    background: var(--success) !important;
+    color: #fff !important;
+}
+
+body.terminal-page .operator-choice-confirm:disabled{
+    opacity: 0.45 !important;
+}
+
+body.terminal-page .operator-choice-cancel{
+    background: #edf2f7 !important;
+    color: var(--primary) !important;
+}
+
+body.terminal-page .operator-choice-close{
+    position: absolute !important;
+    top: 18px !important;
+    right: 22px !important;
+    width: 68px !important;
+    height: 68px !important;
+    border-radius: 50% !important;
+    border: none !important;
+    font-size: 50px !important;
+    line-height: 1 !important;
+    background: #edf2f7 !important;
+    color: var(--primary) !important;
+    cursor: pointer !important;
+    touch-action: manipulation !important;
+}
