+/* ===== terminal: выбор оператора для услуги ===== */
+body.terminal-page .operator-choice-overlay{
+    position: fixed;
+    inset: 0;
+    z-index: 10002;
+    background: rgba(0, 0, 0, 0.68);
+    display: none;
+    align-items: center;
+    justify-content: center;
+    padding: 24px;
+    box-sizing: border-box;
+}
+
+body.terminal-page .operator-choice-modal{
+    position: relative;
+    width: min(760px, 92vw);
+    background: var(--card-bg);
+    border-radius: 28px;
+    box-shadow: 0 30px 80px rgba(0,0,0,0.45);
+    padding: 44px 42px 38px 42px;
+    box-sizing: border-box;
+    text-align: center;
+}
+
+body.terminal-page .operator-choice-modal h2{
+    margin: 0 0 12px 0;
+    color: var(--primary);
+    font-size: 36px;
+    font-weight: 800;
+    text-transform: uppercase;
+}
+
+body.terminal-page .operator-choice-service{
+    margin-bottom: 28px;
+    color: var(--text-muted);
+    font-size: 22px;
+    font-weight: 700;
+    line-height: 1.25;
+}
+
+body.terminal-page .operator-choice-close{
+    position: absolute;
+    top: 14px;
+    right: 18px;
+    width: 54px;
+    height: 54px;
+    border: none;
+    border-radius: 50%;
+    background: #f1f5f9;
+    color: var(--primary);
+    font-size: 42px;
+    line-height: 1;
+    font-weight: 700;
+    cursor: pointer;
+}
+
+body.terminal-page .operator-choice-select{
+    width: 100%;
+    min-height: 76px;
+    padding: 18px 22px;
+    border: 3px solid #e2e8f0;
+    border-radius: 16px;
+    background: #fff;
+    color: var(--text-main);
+    font-size: 26px;
+    font-weight: 700;
+    box-sizing: border-box;
+    outline: none;
+}
+
+body.terminal-page .operator-choice-select:focus{
+    border-color: var(--accent);
+    box-shadow: 0 0 0 5px rgba(0, 170, 255, 0.12);
+}
+
+body.terminal-page .operator-choice-error{
+    min-height: 28px;
+    margin: 18px 0 8px 0;
+    color: var(--danger);
+    font-size: 20px;
+    font-weight: 700;
+}
+
+body.terminal-page .operator-choice-actions{
+    display: flex;
+    gap: 18px;
+    justify-content: center;
+    flex-wrap: wrap;
+    margin-top: 12px;
+}
+
+body.terminal-page .operator-choice-actions button{
+    min-width: 220px;
+    min-height: 70px;
+    border: none;
+    border-radius: 16px;
+    padding: 18px 24px;
+    font-size: 22px;
+    font-weight: 800;
+    cursor: pointer;
+    text-transform: uppercase;
+}
+
+body.terminal-page .operator-choice-confirm{
+    background: var(--success);
+    color: #fff;
+}
+
+body.terminal-page .operator-choice-cancel{
+    background: #e2e8f0;
+    color: var(--text-main);
+}
+
+body.terminal-page .operator-choice-actions button:disabled{
+    opacity: 0.55;
+    cursor: not-allowed;
+}
