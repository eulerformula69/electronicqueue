+            </div>
+        </div>
+    `;
+
+    document.body.appendChild(overlay);
+    return overlay;
+}
+
+function closeOperatorChoiceModal() {
+    const overlay = document.getElementById("operator-choice-overlay");
+    if (overlay) overlay.style.display = "none";
+    window.pendingOperatorChoice = null;
+}
